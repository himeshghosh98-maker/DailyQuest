# ===== DailyQuest server configuration =====
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database (MongoDB) ---
# Local:    mongodb://127.0.0.1:27017/dailyquest
# Atlas:    mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dailyquest?retryWrites=true&w=majority
# Leave empty for a throwaway in-memory dev database (auto, dev only).
MONGODB_URI=

# --- Auth ---
# Any long random string. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Gemini AI (never exposed to the frontend) ---
# Free API key: https://aistudio.google.com/apikey
# If empty, AI endpoints fall back to built-in rule-based responses.
GEMINI_API_KEY=
# Pin a Flash model (each model has its own free-tier daily quota).
# gemini-flash-latest always tracks the newest Flash.
GEMINI_MODEL=gemini-3.6-flash
# How long AI responses are cached (hours)
AI_CACHE_HOURS=4
